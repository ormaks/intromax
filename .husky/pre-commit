# Husky puts node_modules/.bin on PATH, so tools are called directly, never
# through `pnpm exec`: a pnpm command waits for pnpm's version-switch lock at
# startup, and one pnpm stuck elsewhere on the machine would stall the commit.

# 1. Lint + format only what's staged (see lint-staged.config.mjs).
lint-staged

# 2. Typecheck every project the pending changes touch — including projects
#    that depend on a changed module (a modules/ui change also checks the
#    portfolio). Nx caches results, so unchanged projects cost nothing.
nx affected -t typecheck --uncommitted
