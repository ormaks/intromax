# Copy to .env. Matches the Postgres container in compose.yaml.
DATABASE_URL=postgres://barbershop:barbershop@localhost:5433/barbershop

# The port the API listens on. Optional, defaults to 3001.
# PORT=3001

# The frontend's origin: the only site whose browser requests may change
# anything (POST, PUT, PATCH, DELETE). Optional, defaults to the local
# Next dev server.
# FRONTEND_ORIGIN=http://localhost:3000

# A long random string shared with the frontend's /api proxy, which sends it
# in X-Proxy-Secret. Only then is X-Forwarded-For trusted as the client's IP.
# Optional: unset, the socket address is always used.
# PROXY_SECRET=
